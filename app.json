{
  "expo": {
    "name": "Tasmee Hifz",
    "slug": "tasmee-hifz",
    "version": "1.0.0",
    "scheme": "tasmeehifz",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.tasmeehifz.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/brand/adaptive-icon.png",
        "backgroundColor": "#1B4332"
      },
      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": false,
            "enableJetifier": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tasmee Hifz uses your location once to calculate accurate prayer times. It is never stored or sent anywhere else."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Tasmee Hifz listens while you recite so it can follow along on the page. On phones with an Arabic speech pack installed it is recognized entirely on your device; otherwise Android sends it to its own speech service to transcribe. Nothing is recorded, kept or uploaded by Tasmee Hifz."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B4332",
          "defaultChannel": "prayer-warning",
          "sounds": [
            "src/assets/audio/adhan.mp3"
          ],
          "icon": "./src/assets/brand/notification-icon.png"
        }
      ],
      "./plugins/withNoRtl"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./src/assets/brand/icon.png"
  }
}
