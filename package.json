{
  "name": "tasmee-hifz",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "bash scripts/dev.sh",
    "android": "expo run:android",
    "gen:data": "node scripts/gen-quran-data.mjs",
    "gen:words": "node scripts/gen-quran-words.mjs",
    "gen:search": "node scripts/gen-quran-search.mjs",
    "gen": "npm run gen:data && npm run gen:words && npm run gen:lines && npm run gen:search && npm run gen:adhkar && npm run gen:adhkar-text && npm run gen:hizb && npm run gen:tone && npm run gen:verify-audio && npm run gen:verify && npm run gen:verify-fonts",
    "gen:verify": "node scripts/verify-pages.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform android --output-dir /tmp/qh-export --clear",
    "postinstall": "patch-package",
    "bench": "tsc -p tsconfig.bench.json && node /tmp/qh-bench/scripts/bench-engine.js",
    "eas-build-post-install": "patch-package",
    "fixtures": "tsc -p tsconfig.bench.json && node /tmp/qh-bench/scripts/make-fixtures.js",
    "gen:verify-fonts": "node scripts/verify-fonts.mjs",
    "gen:lines": "node --experimental-sqlite scripts/gen-mushaf-lines.mjs",
    "gen:layout-check": "node --experimental-sqlite scripts/analyse-mushaf-layout.mjs",
    "gen:hadith": "node scripts/gen-hadith.mjs",
    "gen:adhkar": "node scripts/gen-adhkar.mjs",
    "gen:adhkar-text": "node scripts/gen-adhkar-text.mjs",
    "gen:hizb": "node scripts/gen-hizb.mjs",
    "gen:tone": "node scripts/gen-test-tone.mjs",
    "gen:verify-audio": "node scripts/verify-audio.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "ios": "expo run:ios",
    "gen:icons-check": "node scripts/gen-icons.mjs --check"
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.2.3",
    "@expo-google-fonts/amiri-quran": "^0.2.3",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~54.0.12",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.13",
    "patch-package": "^8.0.0",
    "quran-json": "^3.1.2",
    "quran-meta": "^6.0.17",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  }
}
